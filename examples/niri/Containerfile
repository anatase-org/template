FROM i.anatase.org/base:rolling

# Niri + Noctalia desktop for Anatase
RUN dnf -y --setopt=install_weak_deps=False install \
    niri \
    noctalia \
    konsole \
    xwayland-satellite \
    brightnessctl \
    playerctl \
    greetd \
    dolphin \
    ark \
    ffmpegthumbs \
    kf6-kimageformats \
    kio-extras \
    kio-fuse \
    oo7-daemon \
    oo7-portal \
    pam_oo7 \
    gvfs \
    gvfs-afc \
    gvfs-fuse \
    gvfs-gphoto2 \
    gvfs-mtp \
    gvfs-smb \
    network-manager-applet \
    nm-connection-editor \
    nm-connection-editor-desktop \
    NetworkManager-libreswan-gnome \
    NetworkManager-openconnect-gnome \
    NetworkManager-openvpn-gnome \
    NetworkManager-ppp \
    NetworkManager-ssh-gnome \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-gnome \
    xdg-user-dirs-gtk \
    && dnf clean all

# Installs Noctalia-greeter
RUN . /etc/os-release && \
    dnf -y copr enable lionheartp/Hyprland "fedora-${VERSION_ID}-$(arch)" && \
    dnf -y install noctalia-greeter-git && \
    dnf clean all

RUN systemctl enable greetd.service && \
    systemctl set-default graphical.target

# Copy and run Noctali-greeter to niri
COPY examples/niri/greetd.toml /etc/greetd/config.toml

# Creates a systemwide config for Niri and start Noctalia
COPY examples/niri/niri.kdl /etc/niri/config.kdl

# Cleanup (leave this here)
RUN rm -rf /var && \
    mkdir -p /var/tmp
